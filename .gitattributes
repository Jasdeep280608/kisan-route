  const [good, setGood] = useState(null);
  const [qty, setQty] = useState("");
  const [photoTaken, setPhotoTaken] = useState(false);

  async function submit() {
    const newListing = {
      id: uid(),
      providerId: user.id,
      providerName: user.name,
      providerUpi: user.upi,
      type,
      name: good.name,
      icon: good.icon,
      price: good.price,
      unit: good.unit,
