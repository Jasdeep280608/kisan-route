export default function KisanRouteDemo() {
  const [screen, setScreen] = useState("splash"); // splash -> role -> login -> home
  const [language, setLanguage] = useState(null);
  const [role, setRole] = useState(null);
  const [user, setUser] = useState(null);

  const [listings, setListings] = useState([]);
  const [orders, setOrders] = useState([]);
  const [shipments, setShipments] = useState([]);
  const [loadingData, setLoadingData] = useState(true);

  // poll shared storage every 2s so multi-tab / multi-role demo stays in sync
  useEffect(() => {
    let mounted = true;
    async function refresh() {
      const [l, o, s] = await Promise.all([loadList("listings"), loadList("orders"), loadList("shipments")]);
      if (mounted) {
        setListings(l);
        setOrders(o);
        setShipments(s);
        setLoadingData(false);
      }
    }
    refresh();
    const iv = setInterval(refresh, 2000);
    return () => {
      mounted = false;
      clearInterval(iv);
    };
  }, []);

  function goHome(r) {
    setRole(r);
    setScreen("home");
  }

  if (screen === "splash") return <SplashScreen onNext={(lang) => { setLanguage(lang); setScreen("role"); }} />;
  if (screen === "role") return <RoleScreen onSelect={(r) => { setRole(r); setScreen("login"); }} onBack={() => setScreen("splash")} />;
  if (screen === "login")
    return (
      <LoginScreen
        role={role}
        language={language}
        onLogin={(u) => { setUser(u); goHome(role); }}
        onBack={() => setScreen("role")}
      />
    );

  if (loadingData) return <Shell><div style={{ padding: 40, textAlign: "center" }}>Loading Kisan Route...</div></Shell>;

  const ctx = { user, listings, orders, shipments, setListings, setOrders, setShipments, logout: () => { setUser(null); setScreen("splash"); } };

  if (role === "provider") return <ProviderApp {...ctx} />;
  if (role === "customer") return <CustomerApp {...ctx} />;
  if (role === "driver") return <DriverApp {...ctx} />;
  return null;
}

