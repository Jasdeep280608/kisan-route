function Btn({ children, onClick, variant = "primary", disabled, style }) {
  const base = {
    width: "100%",
    padding: "14px 18px",
    borderRadius: 14,
    border: "none",
    fontWeight: 700,
    fontSize: 15,
    cursor: disabled ? "not-allowed" : "pointer",
    opacity: disabled ? 0.5 : 1,
    transition: "transform .1s",
  };
  const variants = {
    primary: { background: C.leaf, color: "white", boxShadow: "0 4px 14px rgba(27,94,32,.25)" },
    accent: { background: C.yellow, color: C.textDark, boxShadow: "0 4px 14px rgba(249,168,37,.3)" },
    outline: { background: "transparent", color: C.leaf, border: `2px solid ${C.leaf}` },
  };
  return (
    <button
      disabled={disabled}
      onClick={onClick}
      style={{ ...base, ...variants[variant], ...style }}
      onMouseDown={(e) => (e.currentTarget.style.transform = "scale(0.98)")}
      onMouseUp={(e) => (e.currentTarget.style.transform = "scale(1)")}
    >
      {children}
    </button>
  );
}

