function DriverApp({ user, shipments, setShipments, logout }) {
  const [tab, setTab] = useState("home");
  const available = shipments.filter((s) => s.status === "available");
  const mine = shipments.filter((s) => s.driverId === user.id);

  // Simulate GPS movement for any shipment this driver has in progress
  useEffect(() => {
    const iv = setInterval(async () => {
      const current = await loadList("shipments");
      let changed = false;
      const updated = current.map((s) => {
        if (s.driverId === user.id && (s.status === "picked_up" || s.status === "in_transit") && s.progress < 1) {
          changed = true;
          return { ...s, progress: Math.min(1, s.progress + 0.05) };
        }
        return s;
      });
      if (changed) {
        setShipments(updated);
        await saveList("shipments", updated);
      }
    }, 800);
    return () => clearInterval(iv);
  }, [user.id, setShipments]);

  async function accept(id) {
    const current = await loadList("shipments");
    const updated = current.map((s) => (s.id === id && s.status === "available" ? { ...s, status: "accepted", driverId: user.id, driverName: user.name } : s));
    setShipments(updated);
    await saveList("shipments", updated);
    setTab("mine");
  }

  async function updateStatus(id, status) {
    const current = await loadList("shipments");
    const updated = current.map((s) => (s.id === id ? { ...s, status } : s));
    setShipments(updated);
    await saveList("shipments", updated);
    if (status !== "delivered") {
      const orders = await loadList("orders");
      const shipment = updated.find((s) => s.id === id);
      const updatedOrders = orders.map((o) => (o.id === shipment.orderId ? { ...o, status } : o));
      await saveList("orders", updatedOrders);
    }
  }

  async function scanDeliver(id) {
    await updateStatus(id, "delivered");
    const current = await loadList("shipments");
    const shipment = current.find((s) => s.id === id);
    const orders = await loadList("orders");
    const updatedOrders = orders.map((o) => (o.id === shipment.orderId ? { ...o, status: "delivered" } : o));
    await saveList("orders", updatedOrders);
  }

  return (
    <Shell>
      {tab === "home" && <DriverHome user={user} available={available} onAccept={accept} onLogout={logout} />}
      {tab === "mine" && <DriverShipments shipments={mine} onUpdate={updateStatus} onScan={scanDeliver} onBack={() => setTab("home")} />}
      <BottomNav active={tab} onChange={setTab} items={[{ key: "home", icon: "🏠", label: "Available" }, { key: "mine", icon: "🚚", label: "My Trips" }]} />
    </Shell>
  );
}

