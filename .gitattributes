function BuyFlow({ user, listing, listings, setListings, orders, setOrders, onDone }) {
  const [mode, setMode] = useState(null);
  const [qty, setQty] = useState("");
  const [step, setStep] = useState("select");

  const total = qty ? Number(qty) * listing.price : 0;

  async function confirmPayment() {
    setStep("paying");
    // simulate a short payment processing delay
    setTimeout(async () => {
      const updatedListings = listings.map((l) => (l.id === listing.id ? { ...l, remaining: l.remaining - Number(qty) } : l));
      const newOrder = {
        id: uid(),
        listingId: listing.id,
        providerId: listing.providerId,
        providerUpi: listing.providerUpi,
        customerId: user.id,
        customerName: user.name,
        name: listing.name,
        icon: listing.icon,
        quantity: Number(qty),
        unit: listing.unit,
        total,
        status: "paid",
        pickup: listing.location,
        drop: randomPoint(),
        createdAt: Date.now(),
      };
      const updatedOrders = [newOrder, ...orders];

      // auto-create shipment for drivers, distance/time-based pay
      const distanceKm = Number(haversine(newOrder.pickup, newOrder.drop).toFixed(1));
      const minutes = Math.round((distanceKm / 35) * 60);
      const newShipment = {
        id: uid(),
        orderId: newOrder.id,
        driverId: null,
        pickup: newOrder.pickup,
        drop: newOrder.drop,
        distanceKm,
        minutes,
        pay: driverPay(distanceKm, minutes),
        status: "available",
        goodName: listing.name,
        goodIcon: listing.icon,
        providerName: listing.providerName,
        customerName: user.name,
        progress: 0,
      };

      setListings(updatedListings);
      setOrders(updatedOrders);
      await saveList("listings", updatedListings);
      await saveList("orders", updatedOrders);
      const currentShipments = await loadList("shipments");
      const newShipments = [newShipment, ...currentShipments];
      await saveList("shipments", newShipments);

      setStep("done");
    }, 1200);
  }

  return (
    <div style={{ flex: 1, display: "flex", flexDirection: "column", overflow: "hidden" }}>
      <Header title={listing.name} subtitle={listing.providerName} onBack={onDone} />
      <div style={{ padding: 20, overflowY: "auto", flex: 1, display: "flex", flexDirection: "column", gap: 14 }}>
        <Card>
          <div style={{ display: "flex", justifyContent: "space-between" }}>
            <span style={{ background: C.paleGreen, color: C.forest, fontWeight: 700, fontSize: 13, padding: "3px 10px", borderRadius: 20 }}>₹{listing.price}/{listing.unit}</span>
            <span>{listing.remaining} {listing.unit} in stock</span>
          </div>
        </Card>

        {step === "select" && (
          <>
            <Btn onClick={() => { setMode("full"); setQty(String(listing.remaining)); setStep("confirm"); }}>
              Buy Full Stock ({listing.remaining} {listing.unit})
            </Btn>
            <Btn variant="outline" onClick={() => { setMode("partial"); setStep("partial"); }}>
              Buy Custom Quantity
            </Btn>
          </>
        )}

        {step === "partial" && (
          <>
            <label style={{ fontWeight: 700 }}>Quantity ({listing.unit})</label>
            <Input type="number" max={listing.remaining} value={qty} onChange={(e) => setQty(e.target.value)} />
            <Btn disabled={!qty || Number(qty) > listing.remaining || Number(qty) <= 0} onClick={() => setStep("confirm")}>
              Continue
            </Btn>
          </>
        )}

        {step === "confirm" && (
          <Card style={{ background: C.paleGreen }}>
            <div>Quantity: <strong>{qty} {listing.unit}</strong></div>
            <div>Total: <strong>₹{total}</strong></div>
            <Btn style={{ marginTop: 12 }} onClick={() => setStep("pay-screen")}>Pay Now</Btn>
          </Card>
        )}

        {step === "pay-screen" && (
          <Card style={{ textAlign: "center", padding: 24 }}>
            <div style={{ fontSize: 40 }}>📲</div>
            <p style={{ fontWeight: 700 }}>Demo UPI Payment</p>
            <p style={{ fontSize: 13, color: C.textMuted }}>Paying ₹{total} to {listing.providerName}'s UPI ({listing.providerUpi}). No real money moves in this demo.</p>
            <Btn variant="accent" onClick={confirmPayment}>Simulate Payment Success</Btn>
          </Card>
        )}

        {step === "paying" && (
          <Card style={{ textAlign: "center", padding: 30 }}>
            <div style={{ fontSize: 30 }}>⏳</div>
            <p>Processing payment...</p>
          </Card>
        )}

        {step === "done" && (
          <Card style={{ textAlign: "center", padding: 24 }}>
            <div style={{ fontSize: 44 }}>✅</div>
            <p style={{ fontWeight: 700 }}>Order placed!</p>
            <p style={{ fontSize: 13, color: C.textMuted }}>The farmer has been notified and a driver will pick this up soon.</p>
            <Btn onClick={onDone}>Back to Marketplace</Btn>
          </Card>
        )}
      </div>
    </div>
  );
}

