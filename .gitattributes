// LOGIN — mobile + OTP (+ UPI for provider/driver)
// ---------------------------------------------------------------------
function LoginScreen({ role, onLogin, onBack }) {
  const [step, setStep] = useState("mobile");
  const [mobile, setMobile] = useState("");
  const [demoOtp, setDemoOtp] = useState("");
  const [otp, setOtp] = useState("");
  const [name, setName] = useState("");
  const [upi, setUpi] = useState("");
  const [error, setError] = useState("");

  function sendOtp() {
    if (!/^[6-9]\d{9}$/.test(mobile)) return setError("Enter a valid 10-digit mobile number");
    setError("");
    const code = String(Math.floor(1000 + Math.random() * 9000));
    setDemoOtp(code);
    setStep("otp");
  }

  function verify() {
    if (otp !== demoOtp) return setError("Incorrect OTP");
    if (!name) return setError("Please enter your name");
    if (role !== "customer" && !upi) return setError("UPI ID is required for this account type");
    setError("");
    onLogin({ id: uid(), mobile, name, upi, role });
  }

  return (
    <Shell>
      <Header title={`${role[0].toUpperCase()}${role.slice(1)} Login`} onBack={onBack} />
      <div style={{ padding: 20, display: "flex", flexDirection: "column", gap: 14, flex: 1 }}>
        {step === "mobile" && (
          <>
            <label style={{ fontWeight: 700 }}>Enter mobile number</label>
            <Input type="tel" maxLength={10} placeholder="98765 43210" value={mobile} onChange={(e) => setMobile(e.target.value.replace(/\D/g, ""))} />
            {error && <p style={{ color: C.danger, fontSize: 13 }}>{error}</p>}
            <Btn onClick={sendOtp}>Send OTP</Btn>
          </>
        )}
        {step === "otp" && (
          <>
            <Card style={{ background: C.softYellow, textAlign: "center" }}>
              <strong>Demo Mode</strong> — no real SMS sent. Your OTP:
              <div style={{ fontSize: 26, fontWeight: 800, letterSpacing: 4, marginTop: 4 }}>{demoOtp}</div>
            </Card>
            <label style={{ fontWeight: 700 }}>Enter OTP</label>
            <Input maxLength={4} value={otp} onChange={(e) => setOtp(e.target.value.replace(/\D/g, ""))} />
            <label style={{ fontWeight: 700 }}>Your name</label>
            <Input value={name} onChange={(e) => setName(e.target.value)} />
            {role !== "customer" && (
              <>
                <label style={{ fontWeight: 700 }}>UPI ID</label>
                <Input placeholder="yourname@bank" value={upi} onChange={(e) => setUpi(e.target.value)} />
              </>
            )}
            {error && <p style={{ color: C.danger, fontSize: 13 }}>{error}</p>}
            <Btn onClick={verify}>Verify & Login</Btn>
          </>
        )}
      </div>
    </Shell>
  );
}

