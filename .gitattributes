// ---------------------------------------------------------------------
// STORAGE HELPERS (wraps window.storage with JSON + graceful fallback)
// ---------------------------------------------------------------------
async function loadList(key) {
  try {
    const res = await window.storage.get(key, true);
    return res ? JSON.parse(res.value) : [];
  } catch {
    return [];
  }
}
async function saveList(key, value) {
  try {
    await window.storage.set(key, JSON.stringify(value), true);
  } catch (e) {
    console.error("storage save failed", e);
  }
}

function uid() {
  return Math.random().toString(36).slice(2, 10);
}

function haversine(a, b) {
  const toRad = (d) => (d * Math.PI) / 180;
  const R = 6371;
  const dLat = toRad(b.lat - a.lat);
  const dLng = toRad(b.lng - a.lng);
  const x =
    Math.sin(dLat / 2) ** 2 +
    Math.cos(toRad(a.lat)) * Math.cos(toRad(b.lat)) * Math.sin(dLng / 2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(x), Math.sqrt(1 - x));
}
function driverPay(distanceKm, minutes) {
  return Math.round(60 + distanceKm * 12 + minutes * 1.5);
}

// Random-ish demo coordinates around Delhi NCR so distances look real
function randomPoint() {
  return { lat: 28.6 + (Math.random() - 0.5) * 0.6, lng: 77.2 + (Math.random() - 0.5) * 0.6 };
}

